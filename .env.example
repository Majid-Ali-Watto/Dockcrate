# Only used when deployed (Vercel). All optional.

# Canonical origin for canonical / Open Graph / sitemap URLs. Defaults to the Vercel production domain,
# or to the request's own host. Set it when you serve the site from a custom domain.
SITE_URL=

# Force the hosted behaviour (new-project generation only, no folder access) on a non-Vercel server.
# DOCKCRATE_HOSTED=1
